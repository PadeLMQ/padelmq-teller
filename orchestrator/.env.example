# Kopieer naar .env op de VPS en vul in. Nooit in git.  chmod 600 .env

# --- waar de gegevens staan -------------------------------------------------
# Bewust buiten de repository: hier komt de kennisbasis met je businessregels
# te staan, en die hoort niet in een publiek repo.
ORCH_DATA_DIR=/var/lib/orchestrator

# --- modellen ---------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ORCH_EXECUTOR_MODEL=claude-opus-5
ORCH_TRIAGE_MODEL=claude-haiku-4-5
ORCH_REVIEWER_MODEL=

# Prijs per miljoen tokens in euro. Verifieer de actuele tarieven voordat je
# begint; zonder deze twee waarden weigert de kostenbewaking de reviewer.
ORCH_REVIEWER_PRICE_IN=
ORCH_REVIEWER_PRICE_OUT=

# --- budgetten (euro) -------------------------------------------------------
ORCH_BUDGET_GLOBAL_DAILY_EUR=5
ORCH_BUDGET_PROJECT_DAILY_EUR=5
ORCH_BUDGET_TASK_EUR=2
ORCH_BUDGET_RUN_EUR=1

# --- meldingen --------------------------------------------------------------
ORCH_GITHUB_TOKEN=
ORCH_SMTP_HOST=
ORCH_SMTP_PORT=587
ORCH_SMTP_USER=
ORCH_SMTP_PASSWORD=
ORCH_MAIL_FROM=
ORCH_MAIL_TO=info@padelmq.be
