# /etc/orchestrator/env — chmod 600, eigenaar root:orchestrator
# Dit bestand bevat geheimen. Het hoort NIET in de repository.

# --- verplicht ---
ORCH_DATA_DIR=/var/lib/orchestrator/data

# Tarieven in de valuta die je hier zet. Er wordt nergens omgerekend.
ORCH_CURRENCY=USD
ORCH_REVIEWER_MODEL=gpt-5.6-terra
ORCH_REVIEWER_PRICE_IN=2.00
ORCH_REVIEWER_PRICE_OUT=12.00
ORCH_REVIEWER_PRICE_CACHED_IN=0.20

# Veiligheidsplafonds. $5/dag is een noodrem, geen streefbedrag.
ORCH_BUDGET_GLOBAL_DAILY_EUR=5
ORCH_BUDGET_PROJECT_DAILY_EUR=5
ORCH_BUDGET_TASK_EUR=2
ORCH_BUDGET_RUN_EUR=1

# --- geheimen: invullen op de server, nooit hier vastleggen ---
OPENAI_API_KEY=
ORCH_GITHUB_TOKEN=
ANTHROPIC_API_KEY=

# --- optioneel: e-mail ---
# ORCH_SMTP_HOST=
# ORCH_SMTP_USER=
# ORCH_SMTP_PASSWORD=
